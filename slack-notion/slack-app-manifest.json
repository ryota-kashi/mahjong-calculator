{
  "display_information": {
    "name": "Notionタスク追加",
    "description": "Slackのメッセージを選んだNotionデータベースにタスクとして追加します",
    "background_color": "#2b2b2b"
  },
  "features": {
    "bot_user": {
      "display_name": "Notionタスク追加",
      "always_online": false
    },
    "shortcuts": [
      {
        "name": "Notionに追加",
        "type": "message",
        "callback_id": "add_to_notion",
        "description": "このメッセージをNotionのデータベースに追加する"
      },
      {
        "name": "Notion DBの設定",
        "type": "global",
        "callback_id": "manage_notion_databases",
        "description": "追加先にするNotionのデータベースを登録する"
      },
      {
        "name": "自分のNotionタスク",
        "type": "global",
        "callback_id": "my_notion_tasks",
        "description": "自分が担当の未完了タスクを開いて完了にする"
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands",
        "users:read",
        "users:read.email",
        "channels:history",
        "groups:history",
        "im:history",
        "mpim:history"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://script.google.com/macros/s/AKfycb.../exec?s=WEBHOOK_SECRET"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
